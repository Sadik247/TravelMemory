# Managed by Ansible
storage:
  dbPath: /var/lib/mongodb

systemLog:
  destination: file
  logAppend: true
  path: /var/log/mongodb/mongod.log

net:
  port: {{ mongo_port }}
  # Listen only on loopback + the private VPC address (never 0.0.0.0)
  bindIp: 127.0.0.1,{{ private_ip }}

processManagement:
  timeZoneInfo: /usr/share/zoneinfo

security:
  authorization: enabled
