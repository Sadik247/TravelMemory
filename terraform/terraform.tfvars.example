# Copy to terraform.tfvars and fill in. terraform.tfvars is git-ignored.
aws_region       = "ap-south-1"
aws_profile      = "default"
project_name     = "travelmemory"

# Your public IP + /32  ->  run: curl -s https://checkip.amazonaws.com
my_ip            = "REPLACE_ME/32"

public_key_path  = "~/.ssh/travelmemory.pub"
private_key_path = "~/.ssh/travelmemory"
