# Generated by Terraform - do not edit by hand. Re-run `terraform apply` to refresh.
[web]
web1 ansible_host=${web_public_ip} private_ip=${web_private_ip}

[db]
db1 ansible_host=${db_private_ip} private_ip=${db_private_ip}

[all:vars]
ansible_user=ubuntu
ansible_ssh_private_key_file=${ssh_key}
web_public_ip=${web_public_ip}
web_private_ip=${web_private_ip}
db_private_ip=${db_private_ip}

[db:vars]
# The DB has no public IP: reach it by jumping through the web server (bastion)
ansible_ssh_common_args='-o ProxyCommand="ssh -W %h:%p -q -i ${ssh_key} -o StrictHostKeyChecking=accept-new ubuntu@${web_public_ip}"'
